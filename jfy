def escolher_pasta(inicio, sem_repo=False):
    """Pasta escolhida, None se voltou, "" se o projeto não tem repositório (só com sem_repo)."""
    cur = inicio
    while True:
        subs = sorted((d for d in os.listdir(cur) if not d.startswith(".") and os.path.isdir(os.path.join(cur, d))), key=str.lower)
        limpar()
        print(c(" Escolha a pasta do repositório ", 39, True) + "\n " + c(cur, 214) + "\n")
        for i, d in enumerate(subs, 1):
            eh_git = os.path.isdir(os.path.join(cur, d, ".git"))
            print(f" {c(f'{i:>2}', 39, True)}  {c(d, 78) if eh_git else d}{dim('  git') if eh_git else ''}")
        print("\n " + acoes_txt([("número", "entra"), ("s", "usa esta pasta"), ("..", "sobe"), ("ou cole", "um caminho")]
                                 + ([("n", "sem repositório (estudo, teste)")] if sem_repo else [])))
        op = escolha(seta(), "sn" if sem_repo else "s", len(subs))  # .. e caminho colado vão até o Enter
        if op == "0":
            return None
        if op == "n":
            return ""
        if op == "s":
            return cur
        if op == "..":
            cur = os.path.dirname(cur)
            continue
        if op.isdigit() and 1 <= int(op) <= len(subs):
            alvo = os.path.join(cur, subs[int(op) - 1])
            if os.path.isdir(os.path.join(alvo, ".git")) and escolha(f"Usar {c(alvo, 78)}? (enter = sim, n = entrar na pasta) ", "sn") != "n":
                return alvo
            cur = alvo
            continue
        alvo = os.path.join(cur, os.path.expanduser(op))
        if os.path.isdir(alvo):
            cur = os.path.realpath(alvo)
        else:
            ask(c("Pasta não existe. Enter para continuar.", 203))


def ultima_pasta(cfg, p=None):
    """Onde o navegador de pastas começa: ao lado do repo do projeto ou do último configurado."""
    reais = [x["repo"] for x in [p or {}, *cfg["projetos"].values()] if x.get("repo") and not x["repo"].startswith(SEM_REPO)]
    return os.path.dirname(reais[0]) if reais else os.path.expanduser("~/Documents")


def configurar(cfg, pid):
    p = cfg["projetos"].get(pid, {})
    repos = []
    while True:  # front e back, por exemplo: a task escolhe quais usa
        repo = escolher_pasta(os.path.dirname(repos[-1]) if repos else ultima_pasta(cfg, p), sem_repo=not repos)
        if repo == "":  # estudo, teste: o Claude abre numa pasta só do projeto
            repos = [os.path.join(SEM_REPO, pid)]
            os.makedirs(repos[0], exist_ok=True)
            break
        if repo and repo not in repos:
            repos.append(repo)
        if not repos:
            return False
        print("\n Repositórios: " + ", ".join(c(os.path.basename(r), 78) for r in repos))
        if escolha(" Mais um repositório neste projeto (front e back, por exemplo)? (s/n) [n] ", "sn") != "s":
            break
    padrao = p.get("nome") or ("" if repos[0].startswith(SEM_REPO) else os.path.basename(repos[0]))
    nome = ask(f"Nome do projeto{f' [{padrao}]' if padrao else ''} (0 volta): ", padrao) or pid
    if nome == "0":
        return False
    cfg["projetos"][pid] = {"nome": nome, "repo": repos[0], "repos": repos}
    save(cfg)
    return True


