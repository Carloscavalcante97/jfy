def ask(msg, default=""):
    try:
        r = input(msg).strip()
    except (EOFError, KeyboardInterrupt):
        print()
        sys.exit(0)
    return r or default


def ask_texto(msg):
    """Várias linhas: termina numa linha vazia. Texto colado com linhas em branco no meio vem inteiro."""
    print(msg)
    linhas = []
    while True:
        l = ask(c("» ", 39, True))
        if l:
            linhas.append(l)
        elif not linhas or not select.select([sys.stdin], [], [], 0.1)[0]:  # nada pendente: o usuário deu Enter
            return "\n".join(linhas).strip()
        else:
            linhas.append("")


def escolha(prompt, teclas="", n=0, prefixos=None):
    """Lê a opção de um menu sem Enter. Letra de `teclas` (e o 0) vale na hora. Número de 1 a `n` (ou letra de
    `prefixos` + número, como a3 = {"a": nº de anexos}) vale assim que não puder crescer: com até 9 opções, na hora;
    com 12, o 1 espera um instante pelo 2º dígito. Texto livre (nome, caminho) vai até o Enter, com backspace.
    Fora de um terminal, cai no input normal."""
    import codecs, termios, tty
    if not sys.stdin.isatty():
        return ask(prompt)
    prefixos = prefixos or {}
    print(prompt, end="", flush=True)
    fd, buf, dec = sys.stdin.fileno(), "", codecs.getincrementaldecoder("utf-8")(errors="ignore")
    antes = termios.tcgetattr(fd)

    def numero():  # "fim": não cresce mais; "talvez": um dígito a mais ainda vale; None: não é opção numerada
        m = re.fullmatch(r"([a-z]?)(\d+)", buf)
        maior = (prefixos.get(m[1]) if m[1] else n) if m else None
        if not maior or not 1 <= int(m[2]) <= maior:
            return None
        return "talvez" if int(m[2]) * 10 <= maior else "fim"

    try:
        tty.setcbreak(fd)
        while True:
            # os.read, não sys.stdin: o buffer do Python esconderia do select o dígito já digitado
            ch = dec.decode(os.read(fd, 1))
            if not ch:
                continue  # meio de um caractere com acento
            if ch in ("\n", "\r"):
                break
            if ch in ("\x7f", "\b"):
                if buf:
                    buf = buf[:-1]
                    print("\b \b", end="", flush=True)
            elif not buf and ch in teclas + "0":
                buf = ch
                break
            elif ch.isprintable():
                buf += ch
                print(ch, end="", flush=True)
                st = numero()
                if st == "fim" or (st == "talvez" and not select.select([fd], [], [], 0.7)[0]):
                    break
    except KeyboardInterrupt:
        print()
        sys.exit(0)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, antes)
    print(buf if len(buf) == 1 and buf in teclas + "0" else "")
    return buf.strip()


def seta():
