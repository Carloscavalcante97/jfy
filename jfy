    save(cfg)
    return True


# ---------- execução de uma task (roda na própria aba do tmux) ----------
def ocupado(lock):
    try:
        pid = int(open(lock).read())
        os.kill(pid, 0)
        return pid != os.getpid()
    except (OSError, ValueError):
        return False


def base(repo, tipo="feature"):
    """Ponto de partida gitflow, atualizado do remoto: develop; hotfix sai da main. Sem develop, main/master."""
    git(repo, "fetch", "-q", "origin")
    for n in (["main", "master"] if tipo == "hotfix" else ["develop", "main", "master"]):
        for ref in (f"origin/{n}", n):
            if git(repo, "rev-parse", "--verify", "--quiet", ref).returncode == 0:
                return ref
    return "HEAD"


def garantir_branch(repo, titulo):
    atual = git(repo, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    if not atual or BRANCH_OK.match(atual):
        return
    op = ask(f"Branch atual '{atual}' não é gitflow. Criar a branch da task:\n"
             f"  1 feature  2 bugfix  (saem da develop atualizada)   3 hotfix (sai da main)   0 não criar\n> [1] ", "1")
    if op == "0":
        return
    tipo = {"2": "bugfix", "3": "hotfix"}.get(op, "feature")
    nova = f"{tipo}/{slug(titulo)}"
    if git(repo, "switch", nova).returncode != 0:
        subprocess.run(["git", "switch", "--no-track", "-c", nova, base(repo, tipo)], cwd=repo)


def criar_worktree(repo, titulo):
    # ponytail: worktree só quando o repo já tem outra task rodando; deps (node_modules, venv) não vêm junto
    branch = "feature/" + slug(titulo)
    wt = os.path.join(WT_DIR, os.path.basename(repo) + "-" + slug(titulo))
    if not os.path.isdir(wt):
        if git(repo, "worktree", "add", "--no-track", "-b", branch, wt, base(repo)).returncode != 0:
            subprocess.run(["git", "worktree", "add", wt, branch], cwd=repo, check=True)
        for f in os.listdir(repo):
            if f.startswith(".env") and os.path.isfile(os.path.join(repo, f)):
                shutil.copy2(os.path.join(repo, f), wt)
    print(c(f"Repo ocupado por outra task: usando worktree {wt} ({branch})", 214))
    return wt


