    ("docker", r"com\.docker|\bdocker\b|vpnkit", "docker", 38),
    ("postgres", r"postgres", "postgres", 67),
    ("mysql", r"mysqld|mariadb", "mysql", 30),
    ("redis", r"redis", "redis", 160),
    ("mongo", r"mongod", "folha", 70),
    ("ruby", r"\bruby\b|rails|puma", "gema", 124),
]


def tecnologia(cmd):
    return next((t for t in TECNOLOGIAS if re.search(t[1], cmd.lower())), None)


def containers():
    """Porta do Mac -> (nome, imagem) de cada container rodando. Sem Docker: vazio."""
    try:
        out = subprocess.run(["docker", "ps", "--format", "{{.Names}}\t{{.Image}}\t{{.Ports}}"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    return {int(pt): (nome, img) for nome, img, pts in (l.split("\t") for l in out.splitlines() if l.count("\t") == 2)
            for pt in re.findall(r":(\d+)->", pts)}


def lsof_campos(*args):
    """lsof -F: {pid: [valores do campo n]}."""
    r, pid = {}, None
    for l in subprocess.run(["lsof", *args], capture_output=True, text=True).stdout.splitlines():
        if l[:1] == "p":
            pid = int(l[1:])
        elif l[:1] == "n":
            r.setdefault(pid, []).append(l[1:])
    return r


def portas():
    """Portas TCP abertas por programas de desenvolvimento: o que é, de que projeto, se tem Claude no repo e como parar.
    Fica de fora o que não é de desenvolvimento (Figma, CleanMyMac, o próprio macOS)."""
    cfg, casa = load(), os.path.expanduser("~")
    abertas = {pid: {int(n.rsplit(":", 1)[1]) for n in ns} for pid, ns in lsof_campos("-nP", "-iTCP", "-sTCP:LISTEN", "-Fpn").items()}
    ps = {}  # pid -> (ppid, comando)
    for l in subprocess.run(["ps", "-axo", "pid=,ppid=,command="], capture_output=True, text=True).stdout.splitlines():
        a, b, cmd = (l.split(None, 2) + [""])[:3]
        ps[int(a)] = (int(b), cmd)
    claudes = {pid for pid, (_, cmd) in ps.items() if os.path.basename(cmd.split(" ")[0]) == "claude"}
    cwd = {pid: os.path.realpath(ns[0]) for pid, ns in
           (lsof_campos("-a", "-d", "cwd", "-Fn", "-p", ",".join(map(str, [*abertas, *claudes]))) if abertas else {}).items()}
    raizes = [(os.path.realpath(r), k) for k, pr in cfg["projetos"].items() for r in repos_de(pr)]
    paineis = [l.split("\t", 1) for l in subprocess.run(TMUX + ["list-panes", "-a", "-F", "#{pane_current_path}\t#{window_name}"],
                                                         capture_output=True, text=True).stdout.splitlines() if "\t" in l]
    dentro = lambda pasta, raiz: pasta == raiz or pasta.startswith(raiz + "/")
    docker, linhas = containers(), []

    def pelo_claude(pid):  # o Claude subiu o servidor (npm run dev num Bash dele) e ele ficou rodando
        for _ in range(30):
            pid = ps.get(pid, (0,))[0]
            if pid in claudes:
                return True
            if pid <= 1:
                return False
        return False

    for pid, pts in abertas.items():
        tec = tecnologia(ps.get(pid, (0, ""))[1])
        if tec and tec[0] == "docker":  # quem abre a porta é o Docker: uma linha por container
            for nome, img in sorted({docker[pt] for pt in pts if pt in docker}):
                t = tecnologia(img) or tec
