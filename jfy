METODOS_MERGE = ("squash", "merge", "rebase")


def gh(*args):
    """Roda o gh (a conta ativa dele) e devolve o JSON, ou o texto. Erro do gh vira a mensagem que o app mostra."""
    if not shutil.which("gh"):
        sys.exit("Instale o GitHub CLI (brew install gh) e conecte sua conta.")
    r = subprocess.run(["gh", *args], capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError((r.stderr or r.stdout).strip() or f"gh {args[0]} falhou")
    try:
        return json.loads(r.stdout)
    except ValueError:
        return r.stdout.strip()


def slug_github(url):
    """'owner/repo' de um remote do GitHub (https ou ssh); None se não for do GitHub."""
    m = re.search(r"github\.com[:/]([^/\s]+/[^/\s]+?)(?:\.git)?/?$", url or "")
    return m[1] if m else None


def pastas_projetos(cfg):
    """[(pid, pasta)] de todos os repositórios dos projetos configurados."""
    return [(pid, r) for pid, pr in cfg["projetos"].items() if pr.get("repo") or pr.get("repos") for r in repos_de(pr)]


def repos_github(cfg):
    """{owner/repo: (pid, pasta)} dos repositórios dos projetos que têm o remote origin no GitHub."""
    out = {}
    for pid, pasta in pastas_projetos(cfg):
        slug = slug_github(git(pasta, "remote", "get-url", "origin").stdout.strip()) if os.path.isdir(pasta) else None
        if slug:
            out.setdefault(slug, (pid, pasta))
    return out


def tasks_no_texto(txt):
    """Ids das tasks do Journify citadas num PR: a linha 'Journify: <id>' que o committer da pipeline põe nos
    commits e os links de task (…?task=<id>) que o pr-creator põe na descrição."""
    return list(dict.fromkeys(re.findall(r"(?m)^Journify:\s*([A-Za-z0-9]{15,30})\s*$", txt or "")
                              + re.findall(r"[?&]task=([A-Za-z0-9]{15,30})", txt or "")))


BUSCA_PRS = """fragment p on PullRequest { number title url isDraft updatedAt repository { nameWithOwner } author { login }
  comments { totalCount } }
query($projetos: String!, $revisar: String!, $meus: String!) {
  projetos: search(type: ISSUE, query: $projetos, first: 100) { nodes { ...p } }
  revisar: search(type: ISSUE, query: $revisar, first: 100) { nodes { ...p } }
  meus: search(type: ISSUE, query: $meus, first: 100) { nodes { ...p } } }"""


def contas_gh(txt=None):
    """(conta ativa, todas) do gh, lidas da config dele: o gh auth status valida cada token pela rede (~7 s)."""
    try:
        txt = open(os.path.expanduser("~/.config/gh/hosts.yml")).read() if txt is None else txt
    except OSError:
        return None, []
    bloco = re.search(r"(?ms)^github\.com:\n(.*?)(?=^\S|\Z)", txt)
    bloco = bloco[1] if bloco else ""
    usuarios = re.search(r"(?ms)^ {4}users:\n((?: {8}.*\n?)*)", bloco)
    ativa = re.search(r"(?m)^ {4}user: (\S+)", bloco)
    return (ativa[1] if ativa else None), re.findall(r"(?m)^ {8}(\S+):", usuarios[1] if usuarios else "")


def github_json():
    """Aba GitHub: as contas do gh e os PRs abertos dos repositórios dos projetos, os que pedem sua revisão e os seus.
    Uma consulta GraphQL só (~2 s); as buscas do gh search, uma por vez, levavam de 4 a 12 s cada."""
    ativa, contas = contas_gh()
    if not ativa:
        return {"conta": None, "contas": [], "repos": [], "prs": [], "revisar": [], "meus": []}
    cfg = load()
    repos = repos_github(cfg)
    # ponytail: sem repo nenhum, a busca dos projetos vira uma que não acha nada (a query não pode ficar vazia)
    filtro = " ".join(f"repo:{r}" for r in repos) or "repo:jfy-sem-repo/nenhum"
    d = gh("api", "graphql", "-f", "query=" + BUSCA_PRS, "-f", f"projetos=is:pr is:open {filtro}",
           "-f", "revisar=is:pr is:open review-requested:@me", "-f", "meus=is:pr is:open author:@me")["data"]

    def item(p):
        slug = p["repository"]["nameWithOwner"]
        pid = repos.get(slug, (None,))[0]
        return {"repo": slug, "n": p["number"], "titulo": p["title"], "autor": (p.get("author") or {}).get("login"),
                "rascunho": p["isDraft"], "atualizado": p["updatedAt"], "url": p["url"],
                "comentarios": (p.get("comments") or {}).get("totalCount", 0),
                "pid": pid, "projeto": cfg["projetos"][pid]["nome"] if pid else None, "cor": cor_hex(pid) if pid else None}
    return {"conta": ativa, "contas": contas,
            "repos": [{"repo": k, "projeto": cfg["projetos"][v[0]]["nome"], "cor": cor_hex(v[0])} for k, v in repos.items()],
            "prs": [item(p) for p in d["projetos"]["nodes"] if p], "revisar": [item(p) for p in d["revisar"]["nodes"] if p],
            "meus": [item(p) for p in d["meus"]["nodes"] if p]}


def pr_json(repo, n):
    """Um PR inteiro: branches, situação do merge, checks, commits, revisões e comentários, e os merges que o repo aceita."""
    p = gh("pr", "view", n, "-R", repo, "--json", "number,title,body,author,url,isDraft,headRefName,baseRefName,mergeable,"
           "mergeStateStatus,reviewDecision,statusCheckRollup,commits,additions,deletions,changedFiles,reviews,comments,createdAt")
    aceita = gh("repo", "view", repo, "--json", "squashMergeAllowed,mergeCommitAllowed,rebaseMergeAllowed")
    quem = lambda x: (x.get("author") or {}).get("login")
    cfg, tasks = load(), []
    for tid in tasks_no_texto("\n".join([p.get("body") or ""] + [c.get("messageBody") or "" for c in p.get("commits") or []]))[:6]:
        try:
            t = mcp("obter_task", taskId=tid)["task"]
            tasks.append({"id": tid, "titulo": t["title"], "status": t["statusId"], "pid": t["projectId"],
                          "projeto": cfg["projetos"].get(t["projectId"], {}).get("nome"), "cor": cor_hex(t["projectId"])})
        except Exception:
            pass  # task apagada ou sem acesso: não aparece
    return {"repo": repo, "n": p["number"], "titulo": p["title"], "corpo": p.get("body") or "", "autor": quem(p), "url": p["url"],
            "rascunho": p["isDraft"], "de": p["headRefName"], "para": p["baseRefName"], "mergeavel": p.get("mergeable"),
            "situacao": p.get("mergeStateStatus"), "revisao": p.get("reviewDecision"), "criado": p.get("createdAt"),
            "mais": p.get("additions", 0), "menos": p.get("deletions", 0), "arquivos": p.get("changedFiles", 0),
            "checks": [{"nome": c.get("name") or c.get("context") or "?",
                        "estado": (c.get("conclusion") or c.get("state") or c.get("status") or "").lower()}
                       for c in p.get("statusCheckRollup") or []],
            "commits": [{"sha": c["oid"][:7], "msg": c.get("messageHeadline", ""), "quando": c.get("committedDate"),
                         "autor": ((c.get("authors") or [{}])[0].get("login") or (c.get("authors") or [{}])[0].get("name"))}
                        for c in p.get("commits") or []],
            "revisoes": [{"autor": quem(r), "estado": r.get("state"), "texto": r.get("body") or "", "quando": r.get("submittedAt")}
                         for r in p.get("reviews") or []],
            "comentarios": [{"autor": quem(c), "texto": c.get("body") or "", "quando": c.get("createdAt")} for c in p.get("comments") or []],
            "tasks": tasks,
            "metodos": [m for m, k in zip(METODOS_MERGE, ("squashMergeAllowed", "mergeCommitAllowed", "rebaseMergeAllowed")) if aceita.get(k)]}


def pr_acao(repo, n, acao, valor=""):
    """O que a aba GitHub faz num PR: merge (valor = squash, merge ou rebase), fechar (sem merge; valor = comentário
    opcional), aprovar (valor = comentário opcional) ou comentar (valor = texto)."""
    if acao == "merge":
        if valor not in METODOS_MERGE:
            sys.exit(f"Merge precisa de um destes: {', '.join(METODOS_MERGE)}")
        gh("pr", "merge", n, "-R", repo, "--" + valor)
        return
    args = {"fechar": ["close", n, "-R", repo] + (["-c", valor] if valor else []),
            "aprovar": ["review", n, "-R", repo, "--approve"] + (["-b", valor] if valor else []),
            "comentar": ["comment", n, "-R", repo, "-b", valor]}.get(acao)
    if not args or (acao == "comentar" and not valor):
        sys.exit("Ação de PR desconhecida, ou comentário vazio.")
    gh("pr", *args)


def cabecalho_status(linha):
    """'## main...origin/main [ahead 1, behind 2]' (git status --branch) -> (branch, upstream, à frente, atrás)."""
    m = re.match(r"## (?:No commits yet on |Nenhum commit ainda em )?(.+?)(?:\.\.\.(\S+))?(?: \[(.*)\])?$", linha or "")
    if not m:
        return None, None, 0, 0
    conta = lambda k: int((re.search(rf"{k} (\d+)", m[3] or "") or [0, 0])[1])
    return m[1], m[2], conta("ahead"), conta("behind")


def repos_json():
    """Aba GitHub, coluna dos repositórios: o git de cada repositório dos projetos (o que o último fetch sabe): branch,
    o que falta subir e baixar, e quantos arquivos mexidos."""
    cfg, out = load(), []
    for pid, pasta in sorted(pastas_projetos(cfg), key=lambda x: (cfg["projetos"][x[0]]["nome"].lower(), x[1])):
        if not os.path.isdir(os.path.join(pasta, ".git")):
            continue
        st = git(pasta, "-c", "core.quotePath=false", "status", "--porcelain=v1", "--branch").stdout.splitlines()
        branch, upstream, frente, atras = cabecalho_status(st[0] if st else "")
        out.append({"pasta": pasta, "nome": os.path.basename(pasta), "projeto": cfg["projetos"][pid]["nome"], "cor": cor_hex(pid),
                    "remote": slug_github(git(pasta, "remote", "get-url", "origin").stdout.strip()),
                    "branch": branch, "upstream": upstream, "frente": frente, "atras": atras, "n_mexidos": len(st) - 1})
    return out


def repo_acao(pasta, acao):
    """fetch, pull (só fast-forward: nunca cria merge sozinho) ou push (a branch atual, criando o upstream se faltar)."""
    if pasta not in {r for _, r in pastas_projetos(load())}:
        sys.exit("Esse repositório não é de um projeto do jfy.")
    args = {"fetch": ["fetch", "--prune"], "pull": ["pull", "--ff-only"], "push": ["push", "-u", "origin", "HEAD"]}.get(acao)
    if not args:
        sys.exit("Ação desconhecida: use fetch, pull ou push.")
    r = git(pasta, *args)
    if r.returncode:
        sys.exit((r.stderr or r.stdout).strip())


