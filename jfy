def contatos_json():
    """Os contatos para a sugestão de emails (envio e convites), do mais usado para o menos: os destinatários dos
    seus enviados, quem te escreveu e os convidados dos seus eventos. Lê de novo no máximo a cada 6 h e, nos enviados,
    só os emails que ainda não leu."""
    from concurrent.futures import ThreadPoolExecutor
    try:
        st = json.load(open(CONTATOS)) if os.path.exists(CONTATOS) else {}
    except ValueError:
        st = {}
    c = st.setdefault("contatos", {})
    if load().get("google") and time.time() - st.get("lido", 0) > 6 * 3600:
        tok, eu = google_token(), None
        eu = conta_gmail(tok).lower()
        vistos = set(st.get("vistos", []))
        def soma(lista, peso):
            for nome, e in lista:
                if e.lower() != eu:
                    x = c.setdefault(e.lower(), {"nome": nome or "", "n": 0})
                    x["n"] += peso
                    x["nome"] = x["nome"] or nome or ""
        cota = []  # o Google pediu para esperar: para aqui e continua na próxima (a leitura é incremental)

        def meta(i, q):
            if cota:
                return i, None
            try:
                return i, http_json(f"{GMAIL}/{i}?format=metadata&{q}", token=tok)
            except RuntimeError as e:
                if "403" in str(e) or "429" in str(e):
                    cota.append(e)
                    return i, None
                raise
        try:
            # ponytail: os 80 enviados e os 40 recebidos mais novos, em lotes de 10 com pausa: a cota do Gmail é por
            # segundo e por minuto (400 de uma vez estouraram); as próximas leituras só pegam o que é novo
            for rotulo, campos, peso, n in (("SENT", ("To", "Cc"), 2, 80), ("INBOX", ("From",), 1, 40)):
                ids = [x["id"] for x in http_json(f"{GMAIL}?labelIds={rotulo}&maxResults={n}", token=tok).get("messages", []) if x["id"] not in vistos]
                q = "&".join(f"metadataHeaders={x}" for x in campos)
                for k in range(0, len(ids), 10):
                    with ThreadPoolExecutor(5) as ex:
                        for i, m in ex.map(lambda i: meta(i, q), ids[k:k + 10]):
                            if m:
                                soma([a for x in m["payload"].get("headers", []) for a in enderecos(x["value"])], peso)
                                vistos.add(i)
                    if cota:
                        break
                    time.sleep(0.4)
            if not cota:
                ini = datetime.now().astimezone() - timedelta(days=120)
                qa = {"timeMin": ini.isoformat(), "timeMax": (ini + timedelta(days=150)).isoformat(), "singleEvents": "true", "maxResults": 2500}
                for e in http_json(f"{CAL}?{urllib.parse.urlencode(qa)}", token=tok).get("items", []):
                    soma([(a.get("displayName"), a.get("email", "")) for a in e.get("attendees", []) if not a.get("resource") and "@" in a.get("email", "")], 1)
        except Exception as e:  # sem rede, cota: a sugestão segue com o que já tem
            print(f"contatos: {e}"[:300], file=sys.stderr)
            cota.append(e)
        st.update(lido=0 if cota else time.time(), vistos=sorted(vistos)[-5000:])
        json.dump(st, open(CONTATOS, "w"), ensure_ascii=False)
    return [{"email": e, "nome": x["nome"]} for e, x in sorted(c.items(), key=lambda kv: -kv[1]["n"])][:500]


