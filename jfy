    # retoma a mesma conversa em modo headless, só com ferramentas de leitura/escrita de arquivo
    subprocess.call(["claude", "-p", "--resume", sid, "--permission-mode", "acceptEdits", "--allowedTools",
                     "Read", "Write", "Edit", "Glob", "Grep", "Bash(git log:*)", "Bash(git status:*)", "Bash(git diff:*)",
                     "Bash(ls:*)", *add_dir([cwd, *outras]), "--", pedido], cwd=cwd, env=dict(os.environ, JFY_SEM_AVISO="1"),
                    stdout=subprocess.DEVNULL)
    # ponytail: o worktree fica (com o handoff.md pendente); git worktree remove depois do merge


def preparar_repo(repo, nome_wt):
    """Trava o repo para esta aba. Se outra aba já usa o repo, devolve um worktree."""
    lock = os.path.join(RUN_DIR, re.sub(r"\W", "_", repo))
    if ocupado(lock):
        # ponytail: pasta sem git (projeto sem repo) é dividida entre as abas, não tem worktree
        return (criar_worktree(repo, nome_wt) if os.path.isdir(os.path.join(repo, ".git")) else repo), None
    open(lock, "w").write(str(os.getpid()))
    return repo, lock


def preparar_repos(repos, nome_wt):
    pastas, locks = [], []
    for r in repos:
        cwd, lock = preparar_repo(r, nome_wt)
        pastas.append(cwd)
        locks += [lock] if lock else []
    return pastas, locks


def abrir_claude(cwd, contexto, pedido, locks, sid=None, extra=()):
    """Roda o Claude até o /exit. Devolve a hora (epoch) em que ele abriu."""
    cronometro("ligar")
    t0 = time.time()
    try:
        subprocess.call(["claude", "--append-system-prompt", contexto, *extra] + (["--session-id", sid] if sid else [])
                        + (["--", pedido] if pedido else []), cwd=cwd)
    finally:
        for lock in locks or ():
            os.remove(lock)
    return t0


