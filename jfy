def acoes_txt(pares, sair="0 volta"):
    """Linha de ações igual em toda tela: a tecla em destaque e o que ela faz; o 0 apagado no fim."""
    return "   ".join([c(k, 39, True) + " " + t for k, t in pares] + ([dim(sair)] if sair else []))


def corta(txt, n):
    txt = txt.strip()
    return txt if len(txt) <= n else txt[:max(n, 2) - 1] + "…"


def menu(titulo, itens, acoes=(), zero="volta", teclas=""):
    limpar()
    print(c(f" {titulo} ", 39, True) + "\n")
    i = 0
    for txt in itens:
        if txt is None:  # separador, não conta na numeração
            print()
            continue
        if isinstance(txt, tuple):  # (título[, nota]) = cabeçalho de seção, não conta na numeração
            print(("\n" if i else "") + " " + c(txt[0], 244, True) + (dim("  " + txt[1]) if txt[1:] else ""))
            continue
        i += 1
        print(f" {c(f'{i:>2}', 39, True)}  {txt}")
    print("\n " + acoes_txt(acoes, "0 " + zero))
    return escolha(seta(), teclas)


def doc_texto(node, depth=0):
    """Descrição do Journify (JSON ProseMirror) para texto simples."""
    if isinstance(node, str):
        try:
            node = json.loads(node)
        except ValueError:
            return node
    t = node.get("type")
    if t == "text":
        txt = node.get("text", "")
        return f"**{txt}**" if any(m.get("type") == "bold" for m in node.get("marks", [])) else txt
    if t == "image":
        return f"![]({(node.get('attrs') or {}).get('src', '')})\n"
    if t == "hardBreak":
        return "\n"
    filhos = node.get("content", [])
    if t == "listItem":
        return "  " * depth + "- " + "".join(doc_texto(x, depth + 1) for x in filhos).strip() + "\n"
    if t in ("bulletList", "orderedList"):
        return "".join(doc_texto(x, depth) for x in filhos)
    inner = "".join(doc_texto(x, depth) for x in filhos)
    if t == "heading":
        return "\n" + "#" * node["attrs"]["level"] + " " + inner + "\n"
    if t == "paragraph":
        return inner + "\n"
    if t == "codeBlock":
        return "```\n" + inner + "\n```\n"
    return inner


def num_anexo(src, anexos):
    """Número (a1, a2…) do anexo que é esta imagem. O id 'cu_<uuid>.png' da migração do ClickUp tem o uuid da URL."""
    for i, x in enumerate(anexos, 1):
        i_d = x.get("id", "")
        if src == x.get("url") or (i_d.startswith("cu_") and i_d[3:].rsplit(".", 1)[0] in src):
            return i


def descricao(texto, anexos, largura):
    """Markdown do ClickUp ou doc do Journify -> linhas limpas no terminal; imagem solta vira 'imagem aN'."""
    linhas, codigo = [], False
    for l in texto.replace("\\[", "[").replace("\\]", "]").splitlines():
        s = l.strip()
        if s.startswith("```"):
            codigo = not codigo
            continue
        if codigo:  # bloco de código / wireframe: recuado e apagado, sem quebrar
            linhas.append(dim("│ " + l.rstrip()[:largura - 2]) if s else "")
            continue
        if s in ("* * *", "*", "---", "***"):
            linhas.append("")
            continue
        l = re.sub(r"!\[[^\]]*\]\(([^)]*)\)",
                   lambda m: c("▣ imagem" + (f" a{n}" if (n := num_anexo(m[1], anexos)) else ""), 39), l)
        if m := re.match(r"\s*#{1,6}\s+(.*)", l) or re.fullmatch(r"\s*\*\*([^*]+)\*\*:?\s*", l):
            linhas += ["", c(m[1].replace("**", "").strip(), 255, True)]  # título, ou parágrafo todo em negrito
            continue
        if l.startswith("**") and linhas and linhas[-1]:  # parágrafo que abre com rótulo ("**Contexto.** ...")
            linhas.append("")
        l = re.sub(r"^(\s*)[*-]\s+", r"\1• ", re.sub(r"\*\*(.+?)\*\*", "\033[1m\\1\033[22m", l.rstrip()))
        recuo = " " * (len(l) - len(l.lstrip()) + (2 if l.lstrip().startswith("• ") else 0))
        linhas += textwrap.wrap(l, largura, subsequent_indent=recuo) or [""]
    out = []
    for l in linhas:  # uma linha em branco no máximo, nenhuma nas pontas
        if l or (out and out[-1]):
            out.append(l)
    while out and not out[-1]:
        out.pop()
    return out


def faixas(ns):
    """[1, 2, 3, 4, 7] -> 'a1–a4, a7'"""
    gs = [[n for _, n in g] for _, g in itertools.groupby(enumerate(ns), lambda p: p[1] - p[0])]
    return ", ".join(f"a{g[0]}" + (f"–a{g[-1]}" if len(g) > 1 else "") for g in gs)


def slug(s):
    s = unicodedata.normalize("NFKD", s).encode("ascii", "ignore").decode().lower()
    return re.sub(r"[^a-z0-9]+", "-", s).strip("-")[:40].rstrip("-")


def ler_minutos(s):
    """'80', '1h20', '1h', '1:20', '45min' -> minutos; None se não entendeu."""
    m = re.fullmatch(r"(\d+)[h:](\d{1,2})?(?:min|m)?|(\d+)(?:min|m)?", s.strip().lower().replace(" ", ""))
    return None if not m else int(m[1]) * 60 + int(m[2] or 0) if m[1] else int(m[3])


def fmt_min(m):
    return f"{m // 60}h {m % 60:02d}min" if m >= 60 else f"{m}min"


# ---------- prazos ----------
def dias_prazo(t):
    """Dias até o prazo (negativo = atrasada); None se a task não tem prazo."""
    return (date.fromisoformat(t["dueDate"][:10]) - date.today()).days if t.get("dueDate") else None


def urgencia(t):
    """Chave do foco: dias até o prazo; crítica sem prazo próximo vem logo depois. None = fora do foco."""
    n = dias_prazo(t)
    if n is not None and n <= JANELA:
        return n
    return JANELA + 1 if t.get("priority") == "critica" else None


def foco(tasks):
    return sorted((t for t in tasks if urgencia(t) is not None), key=urgencia)


def tag_prazo(t, largura=0):
    n = dias_prazo(t)
    if n is None:
        return c("crítica".ljust(largura), 203) if t.get("priority") == "critica" else " " * largura
    txt = (f"atrasada {-n}d" if n < 0 else "hoje" if n == 0 else "amanhã" if n == 1
           else f"em {n}d" if n <= JANELA else date.fromisoformat(t["dueDate"][:10]).strftime("%d/%m"))
    return c(txt.ljust(largura), 203 if n <= 0 else 214 if n <= 3 else 250, n <= 1)


def linha_foco(cfg, t, largura=0):
    pc = cfg["projetos"].get(t["projectId"])
    proj = c(pc["nome"][:12].ljust(12), cor_projeto(t["projectId"])) if pc else dim(t["projectId"][:8].ljust(12))
    return f"{tag_prazo(t, 12)}  {proj}  {corta(t['title'], largura - 34) if largura else t['title']}"


def ler_data(s, hoje=None, futuro=True):
    """'25/11', '25/11/2026', '+3' / '-1' (daqui a 3 dias / ontem) ou '2026-11-25' -> 'AAAA-MM-DD'; None se inválida.
    futuro=False (horas): '20/11' é o deste ano mesmo que já tenha passado."""
    hoje = hoje or date.today()
    try:
        if re.fullmatch(r"[+-]\d+", s):
            return (hoje + timedelta(days=int(s))).isoformat()
        if "-" in s:
            return date.fromisoformat(s).isoformat()
        d, m, *a = map(int, s.split("/"))
        dt = date((a[0] + 2000 if a[0] < 100 else a[0]) if a else hoje.year, m, d)
        if futuro and not a and dt < hoje:  # dia/mês que já passou este ano: é o do ano que vem
            dt = dt.replace(year=dt.year + 1)
        return dt.isoformat()
    except ValueError:
        return None


