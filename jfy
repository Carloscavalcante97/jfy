def mover_horas(dia, kid, novo):
    """Leva uma linha das horas (task, terminal livre, preparação de reunião) para outro dia, com os ajustes dela. O
    trabalhado não muda: se o outro dia já tem a mesma linha, os dois somam. Reunião fica no dia da agenda. Guarda os
    quatro arquivos antes e confere a soma do trabalhado dos dois dias depois: se não fechar, volta tudo como estava."""
    cfg, d1, d2 = load(), date.fromisoformat(dia), date.fromisoformat(novo)
    if d2 == d1:
        return
    if d2 > date.today():
        sys.exit("Só dá para levar para hoje ou para um dia que já passou.")
    trabalhado = lambda it: it["med"] if it["fixo"] is None else it["fixo"]
    total = lambda d: sum(trabalhado(x) for x in itens_horas(cfg, d)[0] if not x["fora"])
    with contextlib.redirect_stdout(sys.stderr):  # aviso de agenda fora não suja o JSON do app
        it = next((x for x in itens_horas(cfg, d1)[0] if x["kid"] == kid and not x["fora"]), None)
        if not it:
            sys.exit("Essa linha não existe mais nesse dia.")
        if it["reuniao"]:
            sys.exit("Reunião fica no dia em que aconteceu, pela agenda. Para tirar dela daqui, remova a linha.")
        alvo = next((x for x in itens_horas(cfg, d2)[0] if x["kid"] == kid), None)
        if alvo and alvo["fora"]:
            sys.exit(f"Em {d2.strftime('%d/%m')} essa mesma linha está removida: restaure ela lá antes de juntar.")
        antes = total(d1) + total(d2)
    log1, log2 = (os.path.join(HORAS_DIR, d.isoformat() + ".jsonl") for d in (d1, d2))
    aj1, aj2 = ajustes_arq(d1), ajustes_arq(d2)
    copia = {a: open(a).read() if os.path.exists(a) else None for a in (log1, log2, aj1, aj2)}
    try:
        entradas = entradas_do_log(d1)
        da_linha = lambda k: "|".join(str(x) for x in k) == kid
        desloca = (d2 - d1).days * 86400  # o registro passa a ter o horário no dia novo
        vai = [dict(e, ini=e["ini"] + desloca, fim=e["fim"] + desloca) for e, k in entradas if da_linha(k)]
        fica = [e for e, k in entradas if not da_linha(k)]
        with open(log2, "a") as f:  # primeiro grava no dia novo: se algo quebrar no meio, sobra, não some
            f.writelines(json.dumps(e, ensure_ascii=False) + "\n" for e in vai)
        with open(log1, "w") as f:
            f.writelines(json.dumps(e, ensure_ascii=False) + "\n" for e in fica)
        ler = lambda a: json.load(open(a)) if os.path.exists(a) else {}
        a1, a2 = ler(aj1), ler(aj2)
        meu = a1.pop(kid, {})
        if alvo:  # o dia novo já tinha a linha: valem projeto, categoria e descrição de lá, e o trabalhado soma
            junta = {k: v for k, v in a2.get(kid, {}).items() if k != "min"}
            if alvo["fixo"] is not None or it["fixo"] is not None:
                junta["min"] = trabalhado(alvo) + trabalhado(it)
            if junta:
                a2[kid] = junta
        elif meu:
            a2[kid] = meu
        json.dump(a1, open(aj1, "w"), indent=1, ensure_ascii=False)
        json.dump(a2, open(aj2, "w"), indent=1, ensure_ascii=False)
        with contextlib.redirect_stdout(sys.stderr):
            depois = total(d1) + total(d2)
        if depois != antes:
            raise RuntimeError(f"a soma do trabalhado mudou ({antes} → {depois} min)")
    except Exception as erro:
        for a, txt in copia.items():  # volta tudo como estava
            if txt is None:
                if os.path.exists(a):
                    os.remove(a)
            else:
                open(a, "w").write(txt)
        sys.exit(f"Não mudei o dia: {erro}. Nada mudou.")
    return {"para": d2.isoformat(), "trabalhado": trabalhado(it), "juntou": bool(alvo)}


