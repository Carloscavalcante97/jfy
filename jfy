def tasks_pontos(*tids):
    """Os pontos das tasks (a tabela do app carrega depois da lista: a lista do MCP não traz a estimativa, só a task
    inteira). Guarda por 15 min e só busca o que falta, 4 por vez; a que falhar tenta de novo, uma por vez (muitas
    chamadas seguidas e o Journify recusa todas). O MCP não grava pontos: mudar é no Journify."""
    from concurrent.futures import ThreadPoolExecutor
    arq, agora = os.path.join(RUN_DIR, "pontos.json"), time.time()
    try:
        cache = {k: v for k, v in json.load(open(arq)).items() if agora - v[1] < 15 * 60}
    except (OSError, ValueError):
        cache = {}
    erros = []

    def uma(tid):
        try:
            t = mcp("obter_task", taskId=tid)["task"]
        except Exception as e:
            erros.append(str(e))
            return tid, False
        return tid, (t.get("estimate") or {}).get("value") or (t.get("estimateV2") or {}).get("points")
    faltam = [t for t in tids[:120] if t not in cache]
    with ThreadPoolExecutor(4) as ex:
        achados = dict(ex.map(uma, faltam))
    for tid in [t for t, v in achados.items() if v is False]:  # devagar, uma por vez
        time.sleep(0.5)
        achados[tid] = uma(tid)[1]
    cache.update({t: [v, agora] for t, v in achados.items() if v is not False})
    json.dump(cache, open(arq, "w"))
    if any(v is False for v in achados.values()):
        print(f"pontos: o Journify recusou {sum(v is False for v in achados.values())} task(s): {erros[-1][:120]}", file=sys.stderr)
    return {t: cache[t][0] for t in tids if t in cache and cache[t][0] is not None}


def tasks_mudar(campo, valor, *resto):
    """Mudança em lote (as tasks marcadas no app): status, prioridade ou prazo de várias tasks, 4 por vez. Uma que falha
    não para as outras: volta na lista de erros. Status que pede o vídeo do teste (fechado, finalizado validação) leva o
    mesmo link ou motivo para todas: jfy --tasks-mudar status fechado --extra=<link ou motivo> <ids>."""
    from concurrent.futures import ThreadPoolExecutor
    extra = resto[0][len("--extra="):] if resto and resto[0].startswith("--extra=") else ""
    tids = resto[1:] if resto and resto[0].startswith("--extra=") else resto
    if campo not in ("status", "prioridade", "prazo"):
        sys.exit(f"Em lote, só status, prioridade ou prazo (não {campo}).")
    if campo == "status" and valor in PEDE_VIDEO and len(extra.strip()) < 3:
        sys.exit("Esse status pede o link do vídeo do teste (ou o motivo de não ter), que vale para todas as tasks.")
    if not tids:
        sys.exit("Nenhuma task escolhida.")

    def uma(tid):
        try:
            task_mudar(tid, campo, valor, extra)
        except Exception as e:
            return {"id": tid, "erro": str(e)[:200]}
    with ThreadPoolExecutor(4) as ex:
        erros = [e for e in ex.map(uma, tids) if e]
    return {"ok": len(tids) - len(erros), "erros": erros}


