def avisar():
    """Hook Stop/Notification do Claude Code (install.sh liga): notificação do macOS quando o Claude responde ou
    pede permissão. Não avisa se você já está olhando: terminal na frente e, dentro do tmux, a aba dele aberta."""
    if os.environ.get("JFY_SEM_AVISO"):  # claude -p do fechar(): ninguém está esperando essa resposta
        return
    d = json.load(sys.stdin)
    pane = os.environ.get("TMUX_PANE")  # "tmux" sem -L usa o servidor do $TMUX: serve para o jfy e para outro tmux
    tm = lambda fmt: subprocess.run(["tmux", "display", "-p", "-t", pane, fmt], capture_output=True, text=True).stdout.strip()
    sh = lambda *a: subprocess.run(a, capture_output=True, text=True).stdout.strip()
    na_frente = os.environ.get("__CFBundleIdentifier", "?") in sh("lsappinfo", "info", "-only", "bundleid", sh("lsappinfo", "front"))
    # ponytail: fora do tmux não dá para saber a aba do terminal; com o terminal na frente, conta como olhando
    aba_aberta = not pane or tm("#{window_active}") == "1" and tm("#{session_attached}") not in ("0", "")
    if na_frente and aba_aberta:
        return
    onde = tm("#W") if pane else os.path.basename(d.get("cwd", ""))
    titulo = "Claude precisa de você" if d.get("hook_event_name") == "Notification" else "Claude respondeu"
    import shlex
    sock = os.environ.get("TMUX", "").split(",")[0]
    ir = (" ".join(shlex.quote(x) for x in [shutil.which("tmux") or "tmux", "-S", sock, "select-window", "-t", pane])
          if pane and sock else None)  # clique na notificação: terminal na frente, já na aba deste Claude
    notificar(f"{titulo} · {onde}", " ".join((d.get("message") or d.get("last_assistant_message") or "").split())[:140] or "pronto",
              executar=ir)


# ---------- horas (minhas-horas do Journify) ----------
def minutos_uteis(ini, fim):
    """Minutos entre ini e fim (epoch) tirando as reuniões de hoje que caíram no meio."""
    # ponytail: só a agenda de hoje e reuniões sobrepostas descontam duas vezes; raro o bastante
    reun = sum(max(0, min(f, fim) - max(i, ini)) for i, f, *_ in eventos_hoje())
    return max(1, round((fim - ini - reun) / 60))


def registrar_horas(ini, fim, minutos, modo, tid=None, pid=None, titulo=None):
    """Uma linha por trabalho em ~/.jfy/horas/AAAA-MM-DD.jsonl (dia do início): base do jfy --horas."""
    linha = {k: v for k, v in dict(ini=ini, fim=fim, min=minutos, modo=modo, tid=tid, pid=pid, titulo=titulo).items()
             if v is not None}
    with open(os.path.join(HORAS_DIR, date.fromtimestamp(ini).isoformat() + ".jsonl"), "a") as f:
        f.write(json.dumps(linha, ensure_ascii=False) + "\n")


def inflar(linhas, regra):
    """{(…, categoria): minutos medidos} -> minutos a lançar, linha a linha. 'fator' (config "horas", padrão 1) multiplica
    o medido nas linhas de trabalho; reunião fica com a duração da agenda. Múltiplos de 5 min; linha medida não some."""
    f = regra.get("fator", 1)
    return {k: 5 * max(1, round(m * (1 if k[1] == CATEGORIA["reuniao"] else f) / 5)) if m > 0 else 0
            for k, m in linhas.items()}


def horas_do_dia(dia):
    """Linhas medidas do dia: o log do jfy (tasks, terminal livre, preparação de reunião) + reuniões da agenda.
    Devolve (linhas, reunioes): reunioes = {linha: (início, título, palpite?)} para poder definir projeto e contexto."""
    cfg, linhas, tasks = load(), {}, {}
    try:
        log = [json.loads(l) for l in open(os.path.join(HORAS_DIR, dia.isoformat() + ".jsonl"))]
    except OSError:
        log = []
    for e in log:
        tid = e.get("tid")
        if tid and tid not in tasks:
            try:
                tasks[tid] = mcp("obter_task", taskId=tid)["task"]
            except Exception:  # task apagada ou Journify fora: fica o id
                tasks[tid] = {"title": tid}
        t = tasks.get(tid, {})
        k = (e.get("pid") or t.get("projectId"), CATEGORIA.get(e["modo"], "Desenvolvimento"), e.get("titulo") or t.get("title"))
        linhas[k] = linhas.get(k, 0) + e["min"]
    try:
        evs = reunioes_do_dia(dia) if cfg.get("google") else []
    except Exception as e:
        print(c(f"Agenda fora ({e}): reuniões não entraram.", 214))
        evs = []
    reun = {}
    for i, f, titulo, *_ in evs:
        if i >= time.time():  # ainda não aconteceu
            continue
        info = reuniao_info(i, titulo)
        if info:  # você disse o projeto (r ou h): vale isso
            k = (info.get("pid") or info.get("projeto"), CATEGORIA["reuniao"], info.get("contexto") or titulo)
        else:  # palpite pelo apelido no título
            achado = projetos_no_texto(cfg, titulo)
            k = (achado[0] if len(achado) == 1 else None, CATEGORIA["reuniao"], titulo)
        linhas[k] = linhas.get(k, 0) + round((min(f, time.time()) - i) / 60)
        reun[k] = (i, titulo, not info)  # ponytail: duas reuniões na mesma linha (mesmo título e projeto): o número define a última
    return linhas, reun


def chave_reuniao(ini, titulo):
    return datetime.fromtimestamp(ini).strftime("%Y-%m-%d %H:%M ") + titulo


def reuniao_info(ini, titulo):
    """O que você registrou para a reunião: {"pid"} (projeto do jfy) ou {"projeto"} (nome livre), e "contexto"."""
    try:
        return json.load(open(REUNIOES)).get(chave_reuniao(ini, titulo))
    except (OSError, ValueError):
        return None


def gravar_reuniao(ini, titulo, reg):
    # ponytail: o arquivo cresce uns 100 bytes por reunião; limpar os antigos se um dia pesar
    try:
        dados = json.load(open(REUNIOES))
    except (OSError, ValueError):
        dados = {}
    dados[chave_reuniao(ini, titulo)] = reg
    json.dump(dados, open(REUNIOES, "w"), indent=1, ensure_ascii=False)


def nome_projeto(cfg, info_ou_pid):
    """Apelido do jfy, o nome livre que você digitou, ou '?'."""
    p = info_ou_pid if isinstance(info_ou_pid, str) or info_ou_pid is None else info_ou_pid.get("pid") or info_ou_pid.get("projeto")
    return cfg["projetos"].get(p, {}).get("nome", p) if p else "?"


def escolher_projeto(cfg, titulo, palpite=None):
    """Menu dos projetos do jfy. Enter aceita o palpite; texto livre = nome do projeto no Journify (ex.: Souv).
    Devolve {"pid"} ou {"projeto"}, ou None se voltou."""
    pids = sorted(cfg["projetos"], key=lambda p: cfg["projetos"][p]["nome"])
    op = menu(titulo, [c(cfg["projetos"][p]["nome"], cor_projeto(p)) + (dim("  ← enter") if p == palpite else "") for p in pids],
              [("número", "escolhe")] + ([("enter", nome_projeto(cfg, palpite))] if palpite else [])
              + [("ou escreva", "o nome do projeto no Journify (ex.: Souv)")])
    if op == "0" or (not op and not palpite):
        return None
    return ({"pid": pids[int(op) - 1]} if op.isdigit() and 1 <= int(op) <= len(pids)
            else {"projeto": op} if op and not op.isdigit()
            else {"pid": palpite} if palpite in cfg["projetos"] else {"projeto": palpite})


def classificar_reuniao(cfg, ini, titulo):
    """Projeto e contexto de uma reunião, só gravados (sem Claude). O apelido no título é só o palpite do Enter.
    Devolve o registro, ou None se voltou."""
    atual = reuniao_info(ini, titulo) or {}
    achado = projetos_no_texto(cfg, titulo)
    palpite = atual.get("pid") or atual.get("projeto") or (achado[0] if len(achado) == 1 else None)
    hora = datetime.fromtimestamp(ini).strftime("%d/%m %H:%M")
    reg = escolher_projeto(cfg, f"Projeto da reunião {hora} \"{titulo}\"", palpite)
    if reg is None:
        return None
    ctx = ask(f"Contexto, vira a descrição nas horas [{atual.get('contexto') or titulo}]: ", atual.get("contexto", ""))
    if ctx:
        reg["contexto"] = ctx
    gravar_reuniao(ini, titulo, reg)
    return reg


def rotulo_reuniao(cfg, info):
    if not info:
        return dim("sem projeto")
    p = info.get("pid") or info.get("projeto")
    return c(nome_projeto(cfg, info), cor_projeto(p)) + (dim(" · " + info["contexto"]) if info.get("contexto") else "")


def reunioes_do_dia(dia):
    return eventos_hoje() if dia == date.today() else agenda_google(dia)


def hm(m):
    return f"{m // 60}:{m % 60:02d}"


def ajustes_arq(dia):
    return os.path.join(HORAS_DIR, dia.isoformat() + ".ajustes.json")


def gravar_ajuste(dia, kid, **campos):
    """O que você mudou numa linha das horas (p, cat, desc, min, fora), só nesse dia. None/False tira o ajuste."""
    try:
        aj = json.load(open(ajustes_arq(dia)))
    except (OSError, ValueError):
        aj = {}
    a = aj.setdefault(kid, {})
    for k, v in campos.items():
        if v is None or v is False:
            a.pop(k, None)
        else:
            a[k] = v
    if not a:
        aj.pop(kid)
    json.dump(aj, open(ajustes_arq(dia), "w"), indent=1, ensure_ascii=False)


def itens_horas(cfg, dia):
    """As linhas do dia como vão para o Journify: o medido, com os seus ajustes e a regra do config.
    Devolve (itens, medido, total pela regra). Linha removida fica no fim, com fora=True."""
    linhas, reun = horas_do_dia(dia)
    try:
        aj = json.load(open(ajustes_arq(dia)))
    except (OSError, ValueError):
        aj = {}
    itens = []
    for k, m in linhas.items():
        r = reun.get(k)
        kid = "reuniao|" + chave_reuniao(*r[:2]) if r else "|".join(str(x) for x in k)  # reunião: estável mesmo trocando o projeto
        a = aj.get(kid, {})
        itens.append(dict(kid=kid, p=a.get("p", k[0]), cat=a.get("cat", k[1]), desc=a.get("desc", k[2]), med=m,
                          fixo=a.get("min"), fora=a.get("fora", False), reuniao=r, lanc=0))
    vivos = {(i, it["cat"]): it["med"] for i, it in enumerate(itens) if not it["fora"]}
    lanc = inflar(vivos, cfg.get("horas", {}))
    for (i, _), m in lanc.items():
        # ponytail: hora fixada à mão substitui a da regra e não rebalanceia as outras linhas
        itens[i]["lanc"] = m if itens[i]["fixo"] is None else itens[i]["fixo"]
    itens.sort(key=lambda it: (it["fora"], -it["lanc"]))
    return itens, sum(vivos.values()), sum(lanc.values())


def aplicar_ajuste(cfg, dia, it, campo, valor):
    """Muda uma linha das horas, só nesse dia: p (id do jfy ou nome livre), cat, min ("" volta para a regra), desc,
    fora ("1" remove, "" restaura). Reunião: projeto e descrição vão para o reunioes.json, o mesmo do r."""
    r = it["reuniao"]
    if campo == "p" and r:
        ctx = (reuniao_info(*r[:2]) or {}).get("contexto")
        gravar_reuniao(*r[:2], dict({"pid": valor} if valor in cfg["projetos"] else {"projeto": valor}, **({"contexto": ctx} if ctx else {})))
    elif campo == "desc" and r:
        atual = reuniao_info(*r[:2]) or ({"pid": it["p"]} if it["p"] in cfg["projetos"] else {"projeto": it["p"]} if it["p"] else {})
        gravar_reuniao(*r[:2], dict(atual, contexto=valor))
    elif campo == "min":
        gravar_ajuste(dia, it["kid"], min=ler_minutos(valor) if valor else None)
    elif campo == "fora":
        gravar_ajuste(dia, it["kid"], fora=bool(valor))
    elif campo in ("p", "cat", "desc"):
        gravar_ajuste(dia, it["kid"], **{campo: valor or None})  # vazio volta para o medido


def editar_linha_horas(cfg, dia, it):
    """Muda uma linha (só nesse dia), pelo menu do terminal."""
    if it["fora"]:  # removida: o número restaura
        return aplicar_ajuste(cfg, dia, it, "fora", "")
    limpar()
    print(c(" Editar lançamento ", 39, True) + f"  {dia.strftime('%d/%m/%Y')}\n")
    print(f" {c(nome_projeto(cfg, it['p']), cor_projeto(it['p']) if it['p'] else 214, True)} · {it['cat']} · "
          f"{c(hm(it['lanc']), 78, True)} · {it['desc']}\n")
    op = escolha(" " + acoes_txt([("p", "projeto"), ("c", "categoria"), ("h", "horas"), ("d", "descrição"),
                                  ("x", "remover")]) + "\n" + seta(), "pchdx")
    if op == "p":
        reg = escolher_projeto(cfg, f"Projeto de \"{it['desc']}\"", it["p"])
        if reg:
            aplicar_ajuste(cfg, dia, it, "p", reg.get("pid") or reg.get("projeto"))
    elif op == "c":
        cats = list(dict.fromkeys(CATEGORIA.values()))
