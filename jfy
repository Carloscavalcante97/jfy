def agenda_pessoa(email, ini, fim, cfg, meus, cor):
    """A agenda de outra pessoa da empresa, como no "Reunião com…" do Google: os eventos dela no período, com o nome
    dela no título e a cor dela. Os que você também tem ficam de fora (já aparecem). Evento privado vira "Ocupado"."""
    q = {"timeMin": ini.isoformat(), "timeMax": fim.isoformat(), "singleEvents": "true", "orderBy": "startTime", "maxResults": 500}
    try:
        r = http_json(f"https://www.googleapis.com/calendar/v3/calendars/{urllib.parse.quote(email)}/events?{urllib.parse.urlencode(q)}",
                      token=google_token())
    except RuntimeError as e:
        erro = "essa agenda não está compartilhada com você (ou o email não existe)" if " 404" in str(e) or " 403" in str(e) else str(e)[:120]
        return {"email": email, "nome": None, "erro": erro, "eventos": []}
    nome = (r.get("summary") or email) if "@" not in (r.get("summary") or "@") else None
    primeiro = (nome or email.split("@")[0]).split()[0].split(".")[0].capitalize()
    eventos = []
    for e in r.get("items", []):
        if e.get("status") == "cancelled" or e["id"] in meus or e.get("eventType") == "workingLocation":
            continue
        ev = evento_app(dict(e, summary=e.get("summary") or "Ocupado"), cfg)
        ev.update(titulo=f"{primeiro}: {ev['titulo']}", cor=cor, pessoa=email, p=None, projeto=None, palpite=False,
                  pode_editar=False, eu_organizo=False, id=f"{email}|{e['id']}")
        eventos.append(ev)
    return {"email": email, "nome": nome, "erro": None, "eventos": eventos}


