def eventos_hoje(forcar=False):
    """Reuniões de hoje, com cache: busca no máximo a cada 30s (reunião marcada ou apagada agora aparece logo); sem rede,
    fica com o que tinha. O Google só avisa mudança em tempo real para um servidor na internet, então é olhar de novo."""
    hoje = date.today().isoformat()
    if not load().get("google"):
        return []
    try:
        cache = json.load(open(AGENDA))
    except (OSError, ValueError):
        cache = {}
    if forcar or cache.get("data") != hoje or time.time() - cache.get("baixado", 0) > 30:
        try:
            cache = {"data": hoje, "baixado": time.time(), "eventos": agenda_google()}
            json.dump(cache, open(AGENDA, "w"))
        except Exception:  # rede fora ou login revogado não derruba a barra; o jfy --login mostra o erro
            pass
    return cache.get("eventos", []) if cache.get("data") == hoje else []


def reuniao_perto():
    """Reunião que começa em até 1h, ou que está rolando: (evento, minutos até ela), ou (None, 0). Notifica uma vez
    a 5 min. Chamada pela barra do tmux e pelo ícone da barra de cima: a marca evita aviso duplo."""
    agora = time.time()
    for ev in eventos_hoje():
        i, f, t, *r = ev
        if f > agora and i - agora <= 3600:
            m = int((i - agora + 59) // 60)
            marca = os.path.join(RUN_DIR, "reuniao-avisada")
            if 0 < i - agora <= 300 and (not os.path.exists(marca) or open(marca).read() != f"{i}"):
                open(marca, "w").write(f"{i}")
                notificar(f"Reunião em {fmt_min(m)}", t + (" · clique para entrar na chamada" if r and r[0] else ""),
                          abrir=r[0] if r and r[0] else None)
            return ev, m
    return None, 0


def quando_reuniao(ev, m):
    return "agora" if ev[0] <= time.time() else "em " + fmt_min(m)


def proxima_reuniao():
    """Contagem regressiva na barra do tmux."""
    ev, m = reuniao_perto()
    if not ev:
        return ""
    cor = 203 if m <= 5 else 214 if m <= 15 else 39
    # range=user|reuniao: clicar entra na chamada (jfy --entrar, ver o tmux.conf)
    return (f"#[range=user|reuniao fg=colour{cor},bold]{ic('reuniao')} {ev[2][:24].replace('#', '##')} "
            f"{quando_reuniao(ev, m)}#[default norange]  ")


def relogio():
    """Texto da barra do tmux, uma linha por segundo (o andador do tema anda). Fica rodando: o tmux mostra a última
    linha e não chama de novo enquanto ele vive, então não sobe um Python por segundo. Sai quando o jfy muda (o tmux
    sobe o novo no próximo redesenho, até 15s) e quando o tmux fecha. Avisa uma vez por dia quando fecha a jornada."""
    global TEMA
    versao = os.path.getmtime(SELF)
    while os.path.getmtime(SELF) == versao:
        TEMA = TEMAS.get(load().get("tema"), {})  # tema trocado no menu vale aqui sem reiniciar
        m, rodando = cronometro()
        marca, hoje = os.path.join(RUN_DIR, "jornada-avisada"), date.today().isoformat()
        if m >= JORNADA and (not os.path.exists(marca) or open(marca).read() != hoje):
            open(marca, "w").write(hoje)
            notificar("jfy", f"Jornada de {JORNADA // 60}h fechada: {fmt_min(m)} hoje.")
        if not m and not rodando:
            jornada = f"#[fg=colour244]{ic('jornada')} jornada não começou "
        else:
            cor, icone = (78, ic("feito")) if m >= JORNADA else (220, ic("jornada")) if rodando else (244, ic("pausa") + " pausado")
            jornada = f"#[fg=colour{cor},bold]{icone} {fmt_min(m)} / {JORNADA // 60}h#[default] "
        print(tematizar(proxima_reuniao() + email_barra() + barra_ia() + jornada), flush=True)
        time.sleep(1)


