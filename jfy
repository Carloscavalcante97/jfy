def fim(tid, minutos=None, novo=None, nada=False, modo="sessao", video=None, motivo=None):
    """Comenta o tempo gasto e, se pronta, muda o status para `novo` (um dos FINAIS). Sem minutos, usa o relógio do inicio() (sem as reuniões).
    O tempo também vai para o log de horas do dia."""
    arq = os.path.join(RUN_DIR, tid + ".t")
    if nada:  # só desliga o relógio, nada vai para o Journify
        if os.path.exists(arq):
            os.remove(arq)
        return print(dim("Nada registrado no Journify."))
    agora = time.time()
    ini = float(open(arq).read()) if os.path.exists(arq) else agora - 60 * (minutos or 1)
    if minutos is None:
        minutos = minutos_uteis(ini, agora)
    registrar_horas(ini, agora, minutos, modo, tid=tid)  # antes do Journify: o tempo foi trabalhado mesmo se ele falhar
    quando = datetime.now().strftime("%d/%m/%Y %H:%M")
    try:
        mcp("comentar_task", taskId=tid, texto=f"Tempo gasto: {fmt_min(minutos)} (Claude Code, encerrada em {quando})")
        if novo:
            mcp("atualizar_task", taskId=tid, statusId=novo,
                **({"videoTesteUrl": video} if video else {"semVideoMotivo": motivo} if motivo else {}))
    except Exception as e:  # o tempo já está no log do dia: só o Journify ficou sem
        notificar("Erro ao registrar no Journify", f"{fmt_min(minutos)} ficaram nas horas do jfy, mas o Journify recusou: {e}"[:180], app="horas")
        raise
    notificar("Horas registradas", f"{fmt_min(minutos)} no Journify" + (f", status {novo.replace('_', ' ')}" if novo else ""), app="horas")
    if os.path.exists(arq):
        os.remove(arq)
    print(c(f"Journify atualizado: {fmt_min(minutos)}" + (f", status {novo}" if novo else ""), 78))


def rodar(tid, modo="pipeline"):
    cfg = load()
    task = mcp("obter_task", taskId=tid)["task"]
    pid_proj = task["projectId"]
    proj = cfg["projetos"][pid_proj]
    print(c(f" {proj['nome']} ", cor_projeto(pid_proj), True) + " " + c(task["title"], 255, True) + "\n")

    pastas, locks = preparar_repos(repos_da_task(proj), task["title"])
    tipo = None
    for p in pastas if modo == "pipeline" else ():
        if not p.startswith(WT_DIR):  # worktree já nasce na branch da task
            tipo = garantir_branch(p, task["title"], tipo)
    inicio(tid)
    arq = os.path.join(RUN_DIR, tid + ".extra")  # escrito pela tela_task
    notas = ""
    if os.path.exists(arq):
        notas = ("\n\nNotas minhas para esta task (caminhos de arquivo são anexos: leia cada um):\n"
                 + open(arq).read())
        os.remove(arq)
    if modo == "pipeline":
        pedido = f"/pipeline {tid}{notas}"
    else:
        pedido = (f"Task Journify {tid}: \"{task['title']}\". Leia com mcp__journify__obter_task e me ajude a entregá-la "
                  "(estudo, análise, documento, o que ela pedir). Nada vai para o Journify (comentário, status) sem eu aprovar."
                  + notas)
    contexto = (contexto_projeto(proj, pid_proj) + nos_repos(pastas)
                + " Não mude status nem registre tempo no Journify: o jfy faz isso ao sair.")
    sid = str(uuid.uuid4())
    minutos = minutos_uteis(abrir_claude(pastas[0], contexto, pedido, locks, sid, add_dir(pastas)), time.time())

    print("\n" + c(" Fim da sessão ", 39, True) + " " + task["title"])
    d = destino()
    if d is None:
        fim(tid, nada=True)
    else:
        m = ask(f"Tempo gasto, já sem as reuniões (80, 1h20) [{fmt_min(minutos)}]: ")
        fim(tid, ler_minutos(m) or minutos, d[0], modo=modo, video=d[1], motivo=d[2])
    fechar(sid, pastas, fechamento(pid_proj, f"\"{task['title']}\" ({tid})"))
    ask(dim("Enter fecha esta aba."))


def sessao(pid_proj):
    """Um chat só para várias tasks do projeto, uma atrás da outra."""
    cfg = load()
    proj = cfg["projetos"][pid_proj]
    tasks = mcp("minhas_tasks", projetoId=pid_proj)
    print(c(f" {proj['nome']} ", cor_projeto(pid_proj), True) + " " + c("sessão de tasks", 255, True) + "\n")
    pastas, locks = preparar_repos(repos_de(proj), "sessao")
    lista = "\n".join(f"{i}. [{t['statusId']}] {t['title']} ({t['id']})" for i, t in enumerate(tasks, 1))
    pedido = f"""Sessão de várias tasks do projeto '{proj['nome']}' num chat só. Minhas tasks abertas:
{lista}

Regras desta sessão:
- Mostre a lista e pergunte qual fazer (aceito o número). Uma task por vez.
- Ao começar uma task, rode `{SELF} --inicio <id>` e leia a task com mcp__journify__obter_task.
- Task de código: confira se a branch é gitflow (feature/<slug>). Se não for, proponha a branch e espere meu ok. Depois rode o /pipeline com o id da task.
- Task que não é código (estudo, análise, documento): faça direto comigo. Nada vai para o Journify sem eu aprovar.
- Ao terminar, pergunte se a task está pronta e para onde ela vai: em teste, em revisão ou fechado (fechado: peça o link do vídeo do teste ou o motivo de não ter). Pergunte também se quero corrigir o tempo. Rode `{SELF} --fim <id>`, com `--status em_teste`, `--status em_revisao` ou `--status fechado` se estiver pronta (fechado: mais `--video <link>` ou `--sem-video "<motivo>"`) e `--min N` se eu corrigir o tempo (sem --min o jfy usa o relógio). Se eu não quiser registrar, rode `{SELF} --fim <id> --nada`. Nunca mude status nem tempo no Journify de outro jeito.
- Logo depois do --fim, faça o encerramento da task: {fechamento(pid_proj)}
- Depois atualize a lista com mcp__journify__minhas_tasks (projetoId {pid_proj}) e pergunte se seguimos com outra."""
    sid = str(uuid.uuid4())
    abrir_claude(pastas[0], contexto_projeto(proj, pid_proj) + nos_repos(pastas), pedido, locks, sid, add_dir(pastas))

    for t in tasks:  # tasks que ficaram com o relógio ligado
        if os.path.exists(os.path.join(RUN_DIR, t["id"] + ".t")):
            m = ask(f"\n'{t['title']}' ficou aberta. Tempo a registrar (80, 1h20) [enter = relógio, n = não registrar]: ")
            if m == "n":
                os.remove(os.path.join(RUN_DIR, t["id"] + ".t"))
                continue
            d = destino()
            if d is None:
                os.remove(os.path.join(RUN_DIR, t["id"] + ".t"))
                continue
            fim(t["id"], ler_minutos(m), d[0], video=d[1], motivo=d[2])
    fechar(sid, pastas, "A sessão acabou. Se nenhuma task foi trabalhada nesta conversa, não faça nada e responda "
                     "'nada a atualizar'. Senão, confira o encerramento de todas as tasks trabalhadas (inclusive as "
                     "que ficaram pela metade, como em andamento). " + fechamento(pid_proj, "todas as tasks desta sessão"))
    ask(dim("Enter fecha esta aba."))


def livre(pasta):
    """Claude solto numa pasta, sem task: sem relógio, sem Journify, sem pedir permissão.
    Se a pasta é o repo de um projeto configurado, carrega a memória dele."""
    achado = next(((k, p) for k, p in load()["projetos"].items()
                   if os.path.realpath(p["repo"]).lower() == os.path.realpath(pasta).lower()), None)
    pastas = [pasta] + [r for r in repos_de(achado[1]) if r != pasta] if achado else [pasta]
    nome = achado[1]["nome"] if achado else os.path.basename(pasta)
    print(c(f" {nome} ", cor_projeto(achado[0] if achado else pasta), True) + " " + c("terminal livre", 255, True) + "\n")
    contexto = contexto_projeto(achado[1], achado[0]) if achado else "Terminal livre aberto pelo jfy."
    # ponytail: sem lock nem worktree, é uso solto; cuidado ao rodar junto com uma task no mesmo repo
    t0 = abrir_claude(pasta, contexto + nos_repos(pastas), None, None, extra=["--dangerously-skip-permissions", *add_dir(pastas)])
    registrar_horas(t0, time.time(), minutos_uteis(t0, time.time()), "livre", pid=achado[0] if achado else None,
                    titulo="Terminal livre" + ("" if achado else f" em {os.path.basename(pasta)}"))


def preparar(ini):
    """Aba de preparação (p + número no r), opcional: o Claude prepara a pauta com o projeto e o contexto que você deu.
    Reunião não vira task: o tempo vai para as horas (categoria Reunião) do projeto."""
    cfg = load()
    ev = next((e for e in eventos_hoje() if abs(e[0] - float(ini)) < 1), None)
    if not ev:
        return ask(c("Reunião não está mais na agenda de hoje. Enter fecha.", 203))
    i, f, titulo, link, det = (ev + ["", ""])[:5]
    info = reuniao_info(i, titulo) or {}
    pid = info.get("pid")
    proj = cfg["projetos"].get(pid)
    hora = lambda x: datetime.fromtimestamp(x).strftime("%H:%M")
    print(c(f" {proj['nome'] if proj else 'reunião'} ", cor_projeto(pid or titulo), True) + " " + c(titulo, 255, True) + "\n")
    if proj:
        tarefas = "\n".join(f"- [{t['statusId']}] {t['title']} ({t['id']})" for t in mcp("minhas_tasks", projetoId=pid))
        sobre = f"Projeto Journify '{proj['nome']}' ({pid}). Minhas tasks abertas nele:\n{tarefas or '(nenhuma)'}"
    else:
        sobre = f"Projeto: {info['projeto']} (fora do jfy, sem repo)." if info.get("projeto") else "Sem projeto Journify associado."
    if info.get("contexto"):
        sobre += f"\nContexto que eu dei para esta reunião: {info['contexto']}"
    chamada = f" (chamada: {link})" if link else ""
    pedido = f"""Reunião "{titulo}" hoje, {hora(i)}–{hora(f)}{chamada}.
Dados da agenda:
{det or '(sem descrição)'}

{sobre}

Me prepare em poucas linhas. O que eu avancei desde a última reunião deste projeto (git log dos últimos 7 dias, handoff.md e o resumo da última reunião, se mcp__journify__listar_reunioes / obter_reuniao tiverem), o que está em revisão ou teste esperando alguém, bloqueios e as perguntas que eu devo levar.
Não crie task para a reunião nem para o que sair dela: o tempo de reunião vai para as horas do projeto, categoria Reunião."""
    contexto = contexto_projeto(proj, pid) if proj else "Preparação de reunião aberta pelo jfy."
    t0 = abrir_claude(proj["repo"] if proj else os.path.expanduser("~"), contexto, pedido, None)
    registrar_horas(t0, time.time(), minutos_uteis(t0, time.time()), "reuniao", pid=pid or info.get("projeto"), titulo=f"Preparação: {info.get('contexto') or titulo}")


def aba(chave):
    """Id da aba que já roda esta coisa ('--run <id>', '--livre <pasta>'...), ou None."""
    abas = subprocess.run(TMUX + ["list-windows", "-F", "#{window_id}\t#{@jfy}"], capture_output=True, text=True).stdout
    return next((w for w, k in (l.split("\t", 1) for l in abas.splitlines() if "\t" in l) if k == chave), None)


def abrir_aba(nome, pid_proj, *args):
    """Abre a aba. Se a mesma coisa (mesma task, reunião, pasta) já tem aba, só vai para ela: abrir duas vezes a mesma
    task brigava pelo worktree e a segunda aba quebrava."""
    chave = " ".join(args[:2])  # --run <id> vale para /pipeline e livre
    wid = aba(chave)
    if wid:
        return subprocess.run(TMUX + ["select-window", "-t", wid])
    # o tmux expande formatos no nome da janela: "#" vira "##" para o título (de task, reunião, PR) aparecer como é,
    # sem virar formato (e um "#(...)" num título nunca ser lido como comando, em versão nenhuma do tmux)
    wid = subprocess.run(TMUX + ["new-window", "-P", "-F", "#{window_id}", "-n", nome.replace("#", "##"), SELF, *args],
                         capture_output=True, text=True).stdout.strip()
    subprocess.run(TMUX + ["set-window-option", "-t", wid, "window-status-style", f"fg=colour{cor_projeto(pid_proj)}"])
    subprocess.run(TMUX + ["set-window-option", "-t", wid, "@jfy", chave])


