CLAUDE_PROJ = os.path.expanduser("~/.claude/projects")  # transcrições do Claude Code: uma .jsonl por sessão
# US$ por milhão de tokens (preço de API): entrada, saída, leitura de cache. Escrita de cache: 1,25x a entrada
# (5 min) e 2x (1 h); modo rápido, o dobro. Para quem usa a assinatura é o valor equivalente, não a conta.
# ponytail: tabela fixa; modelo novo sem preço aparece em "sem_preco" e entra com custo 0 até alguém pôr aqui
PRECOS = {"claude-opus-5-5": (4, 20, .2), "claude-opus-5": (5, 25, .5), "claude-opus-4-8": (5, 25, .5),
          "claude-sonnet-5-5": (2, 10, .1), "claude-sonnet-5": (2, 10, .2), "claude-haiku-5-5": (.1, .5, .01),
          "claude-fable-5-2": (8, 40, .2), "claude-fable-5-1": (10, 50, .25), "claude-fable-5": (10, 50, 1)}
# /pipeline <id> chega como <command-name>/pipeline</command-name>\n<command-args><id>; conversar, como "Task Journify <id>: "título""
TASK_NO_PEDIDO = re.compile(r'(?:/pipeline</command-name>\\n<command-args>|/pipeline |Task Journify )([A-Za-z0-9]{15,30})(?:: \\"(.+?)\\")?')


def custo_ia(modelo, u):
    """Custo de uma resposta em US$: (entrada, saída, escrita de cache, leitura de cache), economia do cache."""
    if modelo not in PRECOS:
        return (0, 0, 0, 0), 0
    ent, sai, leit = PRECOS[modelo]
    cc = u.get("cache_creation") or {}
    w1h = cc.get("ephemeral_1h_input_tokens", 0)
    w5 = (u.get("cache_creation_input_tokens") or 0) - w1h
    cr = u.get("cache_read_input_tokens") or 0
    x = (2 if u.get("speed") == "fast" else 1) / 1e6
    return ((u.get("input_tokens") or 0) * ent * x, (u.get("output_tokens") or 0) * sai * x,
            (w5 * 1.25 + w1h * 2) * ent * x, cr * leit * x), cr * (ent - leit) / 1e6


def uso(dias=None):
    """Análise do uso do Claude Code a partir das transcrições: custo e tokens por dia, projeto, task, sessão, modelo
    e ferramenta. dias=None: tudo. Uma resposta aparece em mais de um arquivo (resume, fork) e uma vez por bloco
    de conteúdo: conta uma vez só, pelo id."""
    cfg = load()
    desde = date.today() - timedelta(days=dias - 1) if dias else date.min
    raizes = sorted(((os.path.realpath(r), pr["nome"]) for pr in cfg["projetos"].values()
                     if pr.get("repo") or pr.get("repos") for r in repos_de(pr)),
                    key=lambda x: -len(x[0]))
    casa, wt = os.path.realpath(os.path.expanduser("~")), os.path.realpath(WT_DIR)

    def projeto(cwd):
        cwd = os.path.realpath(cwd)
        for r, n in raizes:
            if cwd == r or cwd.startswith(r + "/"):
                return n
        if cwd.startswith(wt + "/"):  # worktree do jfy: <pasta do repo>-<task>
            base = cwd[len(wt) + 1:].split("/")[0]
            return next((n for r, n in raizes if base.startswith(os.path.basename(r) + "-")), base)
        return "~" if cwd == casa else os.path.basename(cwd)

    msgs, ferr, res, sess = {}, {}, {}, {}
    for raiz, _, nomes in os.walk(CLAUDE_PROJ):
        for nome in sorted(nomes):
            if not nome.endswith(".jsonl"):
                continue
            sub = os.path.basename(raiz) == "subagents"
            sid = os.path.basename(os.path.dirname(raiz)) if sub else nome[:-6]
            s = sess.setdefault(sid, {"titulo": None, "task": None, "titulo_task": None, "branch": None, "cwd": None})
            for l in open(os.path.join(raiz, nome), errors="ignore"):
                # ponytail: filtro por texto antes do json.loads; só ~1/3 das linhas precisa ser lida de verdade
                titulo = '"ai-title"' in l and not s["titulo"]
                pedido = not sub and not s["task"] and ("/pipeline" in l or "Task Journify " in l)
                if not (titulo or pedido or '"usage"' in l or '"tool_use"' in l or '"tool_result"' in l):
                    continue
                try:
                    d = json.loads(l)
                except ValueError:
                    continue  # linha cortada (sessão ainda escrevendo)
                m = d.get("message") if isinstance(d.get("message"), dict) else {}
                if titulo:
                    s["titulo"] = d.get("aiTitle")
                if pedido and d.get("type") == "user" and TASK_NO_PEDIDO.search(l):
                    s["task"], s["titulo_task"] = TASK_NO_PEDIDO.search(l).groups()
                if d.get("type") == "assistant":
                    s["cwd"], s["branch"] = d.get("cwd") or s["cwd"], d.get("gitBranch") or s["branch"]
                    if m.get("usage") and m.get("id") and m.get("model") != "<synthetic>" and d.get("timestamp"):
                        msgs.setdefault(m["id"], (d["timestamp"], m.get("model"), m["usage"], sid, sub))
                for b in m.get("content") if isinstance(m.get("content"), list) and d.get("timestamp") else ():
                    if isinstance(b, dict) and b.get("type") == "tool_use":
                        ferr[b["id"]] = (b.get("name"), d["timestamp"])
                    elif isinstance(b, dict) and b.get("type") == "tool_result":
                        res[b.get("tool_use_id")] = len(json.dumps(b.get("content"), ensure_ascii=False)) // 4

    dia = lambda ts: datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone().date()
    vazio = lambda: {"custo": 0, "entrada": 0, "saida": 0, "cache_escrita": 0, "cache_leitura": 0, "respostas": 0}
    grupos = {k: {} for k in ("dia", "projeto", "task", "sessao", "modelo")}
    total, sem_preco, economia, dia_proj, contexto, sub_custo, tipo = vazio(), set(), 0, {}, {}, [0, 0], [0] * 4
    for ts, modelo, u, sid, sub in msgs.values():
        d = dia(ts)
        if d < desde:
            continue
        partes, eco = custo_ia(modelo, u)
        v, economia, tipo = sum(partes), economia + eco, [a + b for a, b in zip(tipo, partes)]
        sem_preco |= set() if modelo in PRECOS else {modelo}
        s = sess[sid]
        p = projeto(s["cwd"] or casa)
        ctx = (u.get("input_tokens") or 0) + (u.get("cache_creation_input_tokens") or 0) + (u.get("cache_read_input_tokens") or 0)
        contexto[sid] = max(contexto.get(sid, 0), ctx)
        sub_custo[sub] += v
        dia_proj[(d.isoformat(), p)] = dia_proj.get((d.isoformat(), p), 0) + v
        for g, k in (("dia", d.isoformat()), ("projeto", p), ("task", s["task"]), ("sessao", sid), ("modelo", modelo)):
            if k is None:
                continue
            for a in (grupos[g].setdefault(k, vazio()), *((total,) if g == "dia" else ())):
                a["custo"] += v
                a["entrada"] += u.get("input_tokens") or 0
                a["saida"] += u.get("output_tokens") or 0
                a["cache_escrita"] += u.get("cache_creation_input_tokens") or 0
                a["cache_leitura"] += u.get("cache_read_input_tokens") or 0
                a["respostas"] += 1
                a.setdefault("sessoes", set()).add(sid)

    titulos = {}
    if grupos["task"]:
        try:
            titulos = {t["id"]: t["title"] for t in mcp("minhas_tasks")}
        except Exception:
            pass  # sem rede ou sem MCP: fica o título do pedido ou o da sessão
    url = cfg.get("journify") or JOURNIFY
    pid_de = {pr["nome"]: k for k, pr in cfg["projetos"].items()}

    def linhas(g, extra=lambda k, a: {}, n=None):
        out = sorted(({"nome": k, **{x: y for x, y in a.items() if x != "sessoes"}, "sessoes": len(a["sessoes"]), **extra(k, a)}
                      for k, a in grupos[g].items()), key=lambda x: -x["custo"])
        return out[:n] if n else out

    def da_task(tid, a):
        ss = [sess[s] for s in a["sessoes"]]
        p = projeto(ss[0]["cwd"] or casa)
        return {"titulo": titulos.get(tid) or next((s["titulo_task"] for s in ss if s["titulo_task"]), None)
                or ss[0]["titulo"] or tid, "projeto": p,
                "url": f"{url}/projects/{pid_de[p]}?task={tid}" if p in pid_de else None}

    def da_sessao(sid, a):
        s = sess[sid]
        tss = [ts for ts, _, _, x, _ in msgs.values() if x == sid]
        return {"titulo": s["titulo"] or "(sem título)", "projeto": projeto(s["cwd"] or casa), "branch": s["branch"],
                "task": s["task"], "inicio": min(tss), "fim": max(tss), "contexto_max": contexto[sid]}

    top = [p["nome"] for p in linhas("projeto")[:6]]
    porpd = {}
    for (d, p), v in dia_proj.items():
        k = (d, p if p in top else "outros")
        porpd[k] = porpd.get(k, 0) + v
    usadas = {}
    for tid, (nome, ts) in ferr.items():
        if dia(ts) >= desde:
            f = usadas.setdefault(nome, {"nome": nome, "chamadas": 0, "resultado_tokens": 0})
            f["chamadas"] += 1
            f["resultado_tokens"] += res.get(tid, 0)
    limites = {}
    for arq in (USO, USO + ".ok"):  # a .ok guarda a última leitura boa (barra_ia)
        try:
            limites = json.load(open(arq)).get("rate_limits") or limites
        except (OSError, ValueError):
            pass
        if limites:
            break
    total["sessoes"] = len(total.pop("sessoes", ()))
    return {
        "gerado": time.time(), "dias": dias, "total": total, "economia_cache": economia, "sem_preco": sorted(sem_preco),
        "custo_por_tipo": dict(zip(("entrada", "saida", "cache_escrita", "cache_leitura"), tipo)),
        "limites": {k: limites.get(k) for k in ("five_hour", "seven_day")},
        "subagentes": {"principal": sub_custo[0], "subagentes": sub_custo[1]},
        "por_dia": sorted(linhas("dia"), key=lambda x: x["nome"]), "por_dia_projeto": [{"dia": d, "projeto": p, "custo": v} for (d, p), v in sorted(porpd.items())],
        "por_projeto": linhas("projeto"), "por_modelo": linhas("modelo"),
        "por_task": linhas("task", da_task, 30), "sessoes": linhas("sessao", da_sessao, 30),
        "ferramentas": sorted(usadas.values(), key=lambda f: -f["chamadas"])[:20],
    }


