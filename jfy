def txt_portas(x):
    return ", ".join(map(str, x["portas"][:3])) + ("…" if len(x["portas"]) > 3 else "")


def encerrar(alvo):
    """alvo: pid ou docker:<container>. Pede para sair; se em 3s não saiu, força. Devolve se parou."""
    if alvo.startswith("docker:"):
        return subprocess.run(["docker", "stop", alvo[7:]], capture_output=True).returncode == 0
    pid = int(alvo)
    for sinal in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.kill(pid, sinal)
            for _ in range(30):
                time.sleep(0.1)
                os.kill(pid, 0)
        except ProcessLookupError:
            return True
        except PermissionError:
            return False
    return False


