def google_sair():
    """Desconecta o Google: revoga o acesso no Google e apaga os tokens do Chaves. O client do app vai para
    google_cliente (conectar de novo não pede o JSON) e o que era da conta antiga zera: não lidos, contatos, agenda vista."""
    cfg = load()
    rt = chaves("jfy-google")
    if rt:
        try:
            http_json("https://oauth2.googleapis.com/revoke", {"token": rt})
        except RuntimeError:
            pass  # já revogado ou expirado: segue apagando daqui
    for servico in ("jfy-google", "jfy-google-acesso"):
        subprocess.run(["security", "delete-generic-password", "-a", "jfy", "-s", servico], capture_output=True)
    if cfg.get("google"):
        cfg["google_cliente"] = {k: cfg["google"][k] for k in ("client_id", "client_secret") if k in cfg["google"]}
        cfg.pop("google")
        save(cfg)
    for arq in (EMAIL, CONTATOS):
        if os.path.exists(arq):
            os.remove(arq)
    if os.path.exists(VIGIAS):
        st = json.load(open(VIGIAS))
