def rgb256(n):
    """Cor 256 do terminal -> (r, g, b). ponytail: só 16-255 (as dos temas); as 16 básicas variam por terminal."""
    if n >= 232:
        return (8 + 10 * (n - 232),) * 3
    nv = [0, 95, 135, 175, 215, 255]
    return nv[(n - 16) // 36], nv[(n - 16) // 6 % 6], nv[(n - 16) % 6]


def desenho(nome):
    txt = open(os.path.join(os.path.dirname(SELF), "fonte", "icones.txt")).read()
    return re.search(rf"^== {re.escape(nome)} [0-9A-F ]+\n((?:[.#]+\n?)+)", txt, re.M)[1].split()


def png(caminho, desenho, rgb, escala=12, dpi=72):
    """Pixel art ('#' pinta, '.' vazio) -> PNG quadrado, fundo transparente, sem dependência (zlib + struct)."""
    import struct, zlib
    larg = max(map(len, desenho))
    lado = max(len(desenho), larg) + 2  # quadrado, com 1 pixel de margem
    y0, x0 = (lado - len(desenho)) // 2, (lado - larg) // 2
    cheio = lambda y, x: 0 <= y - y0 < len(desenho) and 0 <= x - x0 < len(desenho[y - y0]) and desenho[y - y0][x - x0] == "#"
    cor, nada = bytes(rgb) + b"\xff", bytes(4)
    linha = lambda y: b"\0" + b"".join((cor if cheio(y, x) else nada) * escala for x in range(lado))
    bruto = b"".join(linha(y) * escala for y in range(lado))
    bloco = lambda t, d: struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d))
    ppm = round(dpi / 0.0254)  # 144 = o macOS mostra na metade do tamanho, com o dobro de pixels
    open(caminho, "wb").write(b"\x89PNG\r\n\x1a\n" + bloco(b"IHDR", struct.pack(">IIBBBBB", lado * escala, lado * escala, 8, 6, 0, 0, 0))
                              + bloco(b"pHYs", struct.pack(">IIB", ppm, ppm, 1))
                              + bloco(b"IDAT", zlib.compress(bruto)) + bloco(b"IEND", b""))


def imagem_tema():
    """Imagem do tema atual para a direita da notificação: quem anda na barra da IA, ou a chama do jfy.
    Gerada uma vez em ~/.jfy/notif/ (apague a pasta para gerar de novo depois de mexer no icones.txt)."""
    nome = load().get("tema", "Padrão")
    tema, arq = TEMAS.get(nome, {}), os.path.join(HOME, "notif", slug(nome) + ".png")
    if not os.path.exists(arq):
        os.makedirs(os.path.dirname(arq), exist_ok=True)
        png(arq, desenho((tema.get("andador") or ["chama"])[0]), rgb256(tema.get(39, 202)))  # cor de destaque do tema; no Padrão, o laranja da chama do jfy
    return arq


def notificar(titulo, texto, abrir=None, executar=None):
    """Notificação do macOS. Com o terminal-notifier (o install.sh instala), o clique traz o terminal e abre o link
    (`abrir`) ou roda o comando (`executar`, ex.: ir para a aba do Claude). Sem ele, ou sem permissão, a do osascript (o clique abre o Editor de Scripts)."""
    tn = shutil.which("terminal-notifier") or next((x for x in ("/opt/homebrew/bin/terminal-notifier",
                                                                 "/usr/local/bin/terminal-notifier") if os.path.exists(x)), None)
    if tn:
        app = os.environ.get("__CFBundleIdentifier")  # o terminal de onde o jfy (ou o Claude) foi aberto
        extra = (["-open", abrir] if abrir else []) + (["-execute", executar] if executar else []) \
            + (["-activate", app] if app and not abrir else [])
        try:
            extra += ["-contentImage", "file://" + urllib.parse.quote(imagem_tema())]
        except Exception:  # sem imagem, a notificação sai do mesmo jeito
            pass
        if subprocess.run([tn, "-title", titulo, "-message", texto.lstrip("-[") or " ", "-sound", "Glass", *extra],
                          capture_output=True).returncode == 0:
            return
        # sem permissão em Ajustes > Notificações (ou outro erro): cai na do osascript para o aviso não sumir
    subprocess.run(["osascript", "-e", "on run a", "-e",
                    'display notification (item 2 of a) with title (item 1 of a) sound name "Glass"',
                    "-e", "end run", titulo, texto])


def cmd_tmux(*args):
    """Linha de shell que roda um comando no tmux do jfy (para o clique da notificação, que roda fora dele)."""
    import shlex
    return " ".join(shlex.quote(x) for x in [shutil.which("tmux") or "tmux", "-L", "jfy", *args])


def cronometro(acao=None):
    """Blocos de trabalho de hoje em ~/.jfy/dia.json. acao 'ligar': só se ainda não ligou hoje;
    'alternar': pausa/retoma; 'zerar': volta a zero e começa de novo agora. Devolve (minutos hoje, rodando?)."""
    # ponytail: bloco esquecido aberto morre na virada do dia; o dia seguinte começa do zero
    try:
        d = json.load(open(DIA))
    except (OSError, ValueError):
        d = {}
    if d.get("data") != date.today().isoformat():
        d = {"data": date.today().isoformat(), "blocos": []}
    b, agora = d["blocos"], time.time()
    rodando = bool(b) and b[-1][1] is None
    if acao == "zerar":
        b[:] = [[agora, None]]
    elif acao == "alternar" and rodando:
        b[-1][1] = agora
    elif acao == "alternar" or (acao == "ligar" and not b):
        b.append([agora, None])
    if acao:
        json.dump(d, open(DIA, "w"))
    return int(sum((f or agora) - i for i, f in b) // 60), bool(b) and b[-1][1] is None


def barra_ia():
    """Uso dos limites do Claude (janela de 5h e semana), do JSON que o statusline do Claude Code grava em USO."""
    # Claude recém-aberto grava sem rate_limits (só vêm após a 1ª resposta) e o tee trunca antes de escrever:
    # nesses casos usa a última leitura boa, guardada em USO + ".ok"
    for arq in (USO, USO + ".ok"):
        try:
            rl = json.load(open(arq))["rate_limits"]
            j5, j7 = rl.get("five_hour") or {}, rl.get("seven_day") or {}
            break
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            pass
    else:
        return ""
    ok = USO + ".ok"
    if arq == USO and os.path.getmtime(USO) > (os.path.getmtime(ok) if os.path.exists(ok) else 0):  # só se mudou
        json.dump({"rate_limits": rl}, open(ok, "w"))
    vivo = lambda j: time.time() < j.get("resets_at", 0)  # janela que já resetou desde a última gravação = 0%
    p5 = round(j5.get("used_percentage", 0)) if vivo(j5) else 0
    p7 = round(j7.get("used_percentage", 0)) if vivo(j7) else 0
    cheio = min(10, round(p5 / 10))
    ate = " até " + datetime.fromtimestamp(j5["resets_at"]).strftime("%H:%M") if vivo(j5) else ""
    cor = 203 if p5 >= 80 else 214 if p5 >= 50 else 78
    return f"#[fg=colour{cor}]IA {ic('cheio') * cheio}{andador()}{ic('vazio') * (10 - cheio)} {p5}%{ate} #[fg=colour244]· semana {p7}%  "


