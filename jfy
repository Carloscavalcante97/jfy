    itens, pagina = [], None
    while True:
        q = {"timeMin": ini.isoformat(), "timeMax": fim.isoformat(), "singleEvents": "true", "orderBy": "startTime",
             "maxResults": 2500, **({"pageToken": pagina} if pagina else {})}
        r = http_json(f"{CAL}?{urllib.parse.urlencode(q)}", token=google_token())
        itens += r.get("items", [])
        pagina = r.get("nextPageToken")
        if not pagina:
            break
    from concurrent.futures import ThreadPoolExecutor
    emails = [x.strip().lower() for x in pessoas.split(",") if "@" in x][:8]
    meus = {e["id"] for e in itens}
    with ThreadPoolExecutor(4) as ex:
        outras = list(ex.map(lambda i: agenda_pessoa(emails[i], ini, fim, cfg, meus, CORES_PESSOAS[i % len(CORES_PESSOAS)]),
                             range(len(emails))))
    return {"eventos": [evento_app(e, cfg) for e in itens if e.get("status") != "cancelled"
                        and e.get("eventType") not in ("workingLocation",)],
            "projetos": menu_projetos(cfg), "pessoas": outras}


def corpo_evento(d, atual=None):
    """O corpo do evento para a API, do que o app manda: titulo, ini e fim (epoch; no dia inteiro, AAAA-MM-DD, o fim
    incluído), dia_inteiro, descricao, local, convidados (emails) e meet (cria a chamada se o evento não tem).
    Editando, quem continua convidado mantém a resposta que já deu."""
    corpo = {"summary": d.get("titulo") or "(sem título)", "description": d.get("descricao") or "", "location": d.get("local") or ""}
    if d.get("dia_inteiro"):
        corpo["start"] = {"date": d["ini"]}
        corpo["end"] = {"date": (date.fromisoformat(d["fim"]) + timedelta(days=1)).isoformat()}  # o Google quer o dia seguinte
    else:
        corpo["start"] = {"dateTime": datetime.fromtimestamp(float(d["ini"])).astimezone().isoformat()}
        corpo["end"] = {"dateTime": datetime.fromtimestamp(float(d["fim"])).astimezone().isoformat()}
    if "convidados" in d:
        antes = {a.get("email", "").lower(): a for a in (atual or {}).get("attendees", [])}
        corpo["attendees"] = [antes.get(x.strip().lower(), {"email": x.strip()}) for x in d["convidados"] if x.strip()]
        corpo["attendees"] += [a for a in antes.values() if a.get("self") or a.get("resource")
                               and a not in corpo["attendees"]]  # você e as salas não somem do evento
    if d.get("meet") and not (atual or {}).get("hangoutLink") and not (atual or {}).get("conferenceData"):
        corpo["conferenceData"] = {"createRequest": {"requestId": uuid.uuid4().hex, "conferenceSolutionKey": {"type": "hangoutsMeet"}}}
    return corpo


def evento_salvar(dados):
    """Cria (sem id) ou edita (com id: em recorrente, só esta ocorrência) um evento da agenda principal. avisar=True
    manda o convite ou a atualização por email aos convidados."""
    d, cfg = json.loads(dados), load()
    if not cfg.get("google"):
        sys.exit("Agenda não conectada: rode jfy --login no terminal.")
    tok = google_token()
    atual = http_json(f"{CAL}/{urllib.parse.quote(d['id'])}", token=tok) if d.get("id") else None
    q = urllib.parse.urlencode({"conferenceDataVersion": 1, "sendUpdates": "all" if d.get("avisar") else "none"})
    try:
        e = (http_json(f"{CAL}/{urllib.parse.quote(d['id'])}?{q}", token=tok, corpo=corpo_evento(d, atual), metodo="PATCH")
             if atual else http_json(f"{CAL}?{q}", token=tok, corpo=corpo_evento(d)))
    except RuntimeError as erro:
        if "403" in str(erro) and "insufficient" in str(erro).lower():
            sys.exit("Falta a permissão de editar a agenda: rode jfy --login no terminal e aceite.")
        raise
    lembrar_contatos([(None, x.strip()) for x in d.get("convidados", []) if "@" in x])
    return evento_app(e, cfg)


