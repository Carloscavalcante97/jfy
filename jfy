def estado_lancado(dia, itens):
    """(resumo do lançamento ou None, {kid: "lancada" | "mudou" | "nova"}) para a aba Horas."""
    try:
        foto = json.load(open(arq_lancado(dia)))
    except (OSError, ValueError):
        return None, {}
    if foto.get("itens") is None:  # lançado antes de o jfy guardar a foto: só se sabe que o dia já tem horas lá
        return {"em": None, "removidas": 0}, {}
    vivos = [it for it in itens if not it["fora"]]
    estado = {it["kid"]: "nova" if it["kid"] not in foto["itens"]
              else "lancada" if foto["itens"][it["kid"]] == foto_horas(it) else "mudou" for it in vivos}
    return {"em": foto["em"], "removidas": len(set(foto["itens"]) - set(estado))}, estado


